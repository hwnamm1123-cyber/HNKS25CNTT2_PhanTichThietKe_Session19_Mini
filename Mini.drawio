        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;Khách hàng\&quot; as Customer\nparticipant \&quot;khachHangObj:KhachHang\&quot; as KH\nparticipant \&quot;donHangObj:DonHang\&quot; as DH\nparticipant \&quot;sanPhamObj:SanPham\&quot; as SP\n\nCustomer -&gt; KH : dangNhap()\nactivate KH\nKH --&gt; Customer : traKetQuaDangNhap\ndeactivate KH\n\nCustomer -&gt; DH : themVaoGioHang()\nactivate DH\nDH --&gt; Customer : capNhatGioHang\ndeactivate DH\n\nCustomer -&gt; DH : datHang()\nactivate DH\nDH -&gt; SP : kiemTraTonKho()\nactivate SP\nSP --&gt; DH : traKetQuaTonKho\ndeactivate SP\n\nCustomer -&gt; DH : xacNhanDatHang()\nDH -&gt; DH : taoDonHang()\nDH --&gt; Customer : thongBaoThanhCong\ndeactivate DH\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-jfIbEE5RQbAn56CISRA-284">
